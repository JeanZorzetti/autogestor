---
import Vertical from "../layouts/Vertical.astro";
import { porSlug } from "../data/solucoes";
import { EMPRESA, EXTERNOS } from "../consts";

const solucao = porSlug("seguro");

const cotacoes = [
  { rotulo: "Cotar seguro de carro", href: EXTERNOS.cotacaoVeiculo },
  { rotulo: "Cotar seguro de moto", href: EXTERNOS.cotacaoMoto },
  { rotulo: "Cotar seguro de caminhão", href: EXTERNOS.cotacaoCaminhao },
];

const perguntas = [
  {
    p: "Qual a diferença entre seguro e proteção veicular?",
    r: "Seguro é contrato regulado pela SUSEP, com seguradora obrigada a reservas técnicas e indenização prevista em apólice. Proteção veicular é rateio entre associados de uma associação, geralmente mais barato e sem a mesma garantia regulatória. Trabalhamos com os dois e explicamos onde cada um protege melhor no seu caso.",
  },
  {
    p: "Vocês representam uma seguradora só?",
    r: "Não. Somos corretora independente, registro SUSEP 202070004. Cotamos com várias companhias e apresentamos as opções lado a lado — prêmio, franquia, cobertura e o que ficou de fora.",
  },
  {
    p: "O que a assistência 24h cobre?",
    r: "Guincho, chaveiro, troca de pneu, pane seca e transporte alternativo, com acionamento por 0800 em todo o território nacional. O limite de quilometragem do reboque varia por apólice e aparece na comparação.",
  },
  {
    p: "Uso o carro em aplicativo. Muda alguma coisa?",
    r: "Muda, e é importante declarar. Uso remunerado (aplicativo, táxi, locação) altera o risco e o prêmio, e omitir isso pode levar a recusa de indenização no sinistro. Por isso perguntamos a utilização já na cotação.",
  },
  {
    p: "Quem cuida do sinistro depois?",
    r: "Nós. Abertura, acompanhamento da regulação e cobrança de prazo junto à seguradora fazem parte do serviço — é a razão de contratar com corretora em vez de comprar direto no site.",
  },
  {
    p: "Segura veículo importado ou já com anos de uso?",
    r: "Sim, carro, moto e caminhão, nacionais ou importados, novos ou usados. Veículos mais antigos ou raros costumam ter menos companhias dispostas, e é justamente onde a comparação entre várias vale mais.",
  },
];
---

<Vertical
  solucao={solucao}
  h1="Seguro de carro, moto e caminhão cotado em várias seguradoras de uma vez"
  chamada="Corretora independente com registro SUSEP desde 2004, sediada em Goiânia e atendendo todo o Brasil. Comparamos seguro e proteção veicular, mostramos o que cada apólice deixa de fora e cuidamos do sinistro quando ele acontece."
  perguntas={perguntas}
>
  <div slot="hero">
    <ul class="lista-check destaques" role="list">
      <li>Comparação entre companhias, não proposta de uma só</li>
      <li>Assistência 24h nacional por 0800</li>
      <li>Acompanhamento da regulação do sinistro</li>
    </ul>
    <p class="atalho">
      Prefere preencher a cotação completa agora?
      {
        cotacoes.map((c, i) => (
          <>
            {i > 0 ? " · " : " "}
            <a
              class="externo"
              href={c.href}
              target="_blank"
              rel="noopener"
              aria-label={`${c.rotulo} — site do parceiro, abre em nova aba`}
            >
              {c.rotulo.replace("Cotar seguro de ", "")}
            </a>
          </>
        ))
      }
    </p>
  </div>

  <section class="secao">
    <div class="container">
      <span class="olho">O que está incluso</span>
      <h2>O que a Autogestor faz além de vender a apólice</h2>
      <div class="grade grade--2">
        <div class="cartao">
          <h3>Antes de contratar</h3>
          <ul class="lista-check" role="list">
            <li>Cotação em várias seguradoras com o mesmo perfil</li>
            <li>Análise de risco: uso do veículo, garagem, condutor jovem, região</li>
            <li>Comparação de franquia, carro reserva e vidros lado a lado</li>
            <li>Leitura das exclusões — o que a apólice <em>não</em> cobre</li>
          </ul>
        </div>
        <div class="cartao">
          <h3>Depois de contratar</h3>
          <ul class="lista-check" role="list">
            <li>Abertura e acompanhamento do sinistro</li>
            <li>Assistência 24h nacional por 0800</li>
            <li>Gestão de renovação com nova comparação de mercado</li>
            <li>Alteração de condutor, endereço e coberturas durante a vigência</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao--marca">
    <div class="container">
      <span class="olho">Cotação direta</span>
      <h2>Já sabe o que quer? Preencha a cotação completa</h2>
      <p class="chamada">
        Os formulários abaixo são o canal oficial da corretora e pedem os dados completos do veículo e do condutor.
        Se preferir resolver em três campos, use o formulário desta página — a gente pergunta o resto no WhatsApp.
      </p>
      <div class="botoes">
        {
          cotacoes.map((c) => (
            <a class="btn btn--contorno externo" href={c.href} target="_blank" rel="noopener">
              {c.rotulo}
              <span class="visualmente-oculto">— site do parceiro, abre em nova aba</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <span class="olho">Transparência</span>
      <h2>Registro SUSEP {EMPRESA.susep}</h2>
      <p class="chamada">
        Corretor de seguros no Brasil precisa de registro na Superintendência de Seguros Privados para intermediar
        apólice. O nosso é o {EMPRESA.susep}, e pode ser conferido no site da SUSEP. Contratar com corretora
        registrada é o que garante que existe alguém do seu lado na hora da indenização — e não só na hora da venda.
      </p>
    </div>
  </section>
</Vertical>

<style>
  .destaques { margin-top: var(--e-6); font-weight: 600; }
  .atalho { margin-top: var(--e-6); font-size: var(--t-sm); color: var(--texto-suave); }
  .botoes { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-8); }
</style>
