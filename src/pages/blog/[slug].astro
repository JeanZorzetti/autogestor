---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import LeadForm from "../../components/LeadForm.astro";
import { porSlug } from "../../data/solucoes";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const solucao = porSlug(post.data.vertical);

const site = Astro.site ?? new URL("https://autogestor.roilabs.com.br");
const abs = (p: string) => new URL(p, site).href;
const url = abs(`/blog/${post.id}`);

// Spokes do mesmo cluster (`vertical`) linkam entre si — é o que faz o pilar
// acumular relevância em vez de cada post competir sozinho na busca.
const relacionados = (await getCollection("blog")).filter(
  (p) => p.data.vertical === post.data.vertical && p.id !== post.id
);

const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${url}#post`,
    headline: post.data.titulo,
    description: post.data.descricao,
    url,
    datePublished: post.data.publicado.toISOString(),
    dateModified: (post.data.atualizado ?? post.data.publicado).toISOString(),
    inLanguage: "pt-BR",
    author: { "@id": abs("/#organizacao") },
    publisher: { "@id": abs("/#organizacao") },
    mainEntityOfPage: { "@id": `${url}#pagina` },
    about: { "@id": abs(`/${solucao.slug}#servico`) },
  },
];
---

<Base
  titulo={`${post.data.titulo} | Autogestor`}
  descricao={post.data.descricao}
  schema={schema}
  trilha={[
    { nome: "Início", href: "/" },
    { nome: "Blog", href: "/blog" },
    { nome: post.data.titulo, href: `/blog/${post.id}` },
  ]}
>
  <article class="secao post">
    <div class="container post__grade">
      <div class="post__corpo">
        <p class="olho"><a href={`/${solucao.slug}`}>{solucao.nome}</a></p>
        <h1>{post.data.titulo}</h1>
        <div class="post__conteudo">
          <Content />
        </div>

        {
          relacionados.length > 0 && (
            <nav class="post__relacionados" aria-label={`Também sobre ${solucao.nome}`}>
              <h2>Também sobre {solucao.nome}</h2>
              <ul class="lista-limpa" role="list">
                {relacionados.map((p) => (
                  <li>
                    <a href={`/blog/${p.id}`}>{p.data.titulo}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>

      <aside class="post__lateral">
        <LeadForm solucao={solucao} destaque instancia="blog" />
      </aside>
    </div>
  </article>
</Base>

<style>
  .post__grade {
    display: grid;
    gap: var(--e-12);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .post__grade { grid-template-columns: minmax(0, 1fr) minmax(280px, 340px); align-items: start; }
    .post__lateral { position: sticky; top: calc(var(--e-16) + var(--e-4)); }
  }
  .post__corpo h1 { margin-top: var(--e-2); max-width: 24ch; }
  .post__conteudo {
    margin-top: var(--e-8);
    max-width: 72ch;
    color: var(--texto);
    line-height: 1.7;
  }
  .post__conteudo :first-child { margin-top: 0; }
  .post__conteudo p { margin: 0 0 var(--e-4); }
  .post__conteudo h2 {
    margin: var(--e-12) 0 var(--e-4);
    font-size: var(--t-xl);
    scroll-margin-top: var(--e-8);
  }
  .post__conteudo a { color: var(--link); }
  .post__conteudo a:hover { color: var(--link-hover); }
  .post__conteudo table {
    width: 100%;
    margin: var(--e-6) 0;
    border-collapse: collapse;
    font-size: var(--t-sm);
  }
  .post__conteudo th, .post__conteudo td {
    padding: var(--e-3);
    border: 1px solid var(--borda);
    text-align: left;
  }
  .post__conteudo th { background: var(--superficie); font-weight: 700; }
  .post__relacionados {
    margin-top: var(--e-12);
    padding-top: var(--e-8);
    border-top: 1px solid var(--borda);
  }
  .post__relacionados ul { display: grid; gap: var(--e-2); margin-top: var(--e-4); }
  .post__relacionados a { font-weight: 600; color: var(--link); }
</style>
