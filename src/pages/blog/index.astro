---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { porSlug } from "../../data/solucoes";

const posts = (await getCollection("blog")).sort((a, b) => +b.data.publicado - +a.data.publicado);
const vazio = posts.length === 0;

/** Para onde o cluster de energia foi. Sai daqui e não de uma string solta no
 *  markup porque a mesma URL já é o destino do 301 em astro.config.mjs — se um
 *  dia o domínio mudar, os dois precisam mudar juntos. */
const BLOG_COOPLUZ = "https://coopluz.roilabs.com.br/blog";

const site = Astro.site ?? new URL("https://autogestor.roilabs.com.br");
const abs = (p: string) => new URL(p, site).href;

// `timeZone: "UTC"` pelo mesmo motivo de [slug].astro: a data do front matter é
// meia-noite UTC e um build em UTC-3 imprimiria o dia anterior.
const dataCurta = (d: Date) =>
  d.toLocaleDateString("pt-BR", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

// `Blog` com os posts embutidos em vez de `ItemList`: diz o que a página é e o
// que ela lista de uma vez só. Cada nó repete o `@id` que a página do post
// declara, para o buscador costurar os dois como a mesma entidade.
const schema = [
  {
    "@type": "Blog",
    "@id": `${abs("/blog")}#blog`,
    name: "Guias da Autogestor",
    inLanguage: "pt-BR",
    publisher: { "@id": abs("/#organizacao") },
    blogPost: posts.map((p) => ({
      "@type": "BlogPosting",
      "@id": `${abs(`/blog/${p.id}`)}#post`,
      headline: p.data.titulo,
      description: p.data.descricao,
      url: abs(`/blog/${p.id}`),
      datePublished: p.data.publicado.toISOString(),
    })),
  },
];
---

{/* Título e descrição descrevem os posts que EXISTEM. A versão anterior
    prometia seguro, viagens e crédito para uma página só de energia — quem
    clicasse na busca saía. Reescrever quando o segundo cluster entrar.

    O cluster de energia migrou inteiro para o site próprio da Coopluz, e com
    ele os dois únicos posts que este blog tinha. Enquanto não houver post
    aqui, a página sai do índice e diz para onde o conteúdo foi: um índice
    vazio servindo 200 é exatamente o tipo de página que promete e não
    entrega, e o Princípio IV vale para busca também. */}
<Base
  titulo={vazio ? "Blog | Autogestor" : "Guias da Autogestor — conta de luz e energia em Goiás"}
  descricao={
    vazio
      ? "Os guias sobre conta de luz e energia em Goiás passaram a ser publicados no site da Coopluz."
      : "Como funcionam o desconto na conta da Equatorial Goiás, a Lei 14.300 e a compensação de energia por cooperativa. Guias da equipe da Autogestor."
  }
  noindex={vazio}
  schema={schema}
  trilha={[
    { nome: "Início", href: "/" },
    { nome: "Blog", href: "/blog" },
  ]}
>
  <section class="secao">
    <div class="container">
      <span class="olho">Blog</span>
      <h1>Guias da Autogestor</h1>
      {
        vazio ? (
          <>
            <p class="chamada">
              Os guias sobre conta de luz, Lei 14.300 e compensação de energia passaram a ser publicados no site da
              Coopluz, junto com o resto do conteúdo de energia.
            </p>
            <p class="chamada">
              <a class="externo" href={BLOG_COOPLUZ} target="_blank" rel="noopener">
                Ler os guias no site da Coopluz<span class="visualmente-oculto"> — abre em nova aba</span>
              </a>
            </p>
            <p class="chamada">
              Os próximos clusters — seguro, financiamento, consórcio e repasse — continuam sendo publicados aqui.
            </p>
          </>
        ) : (
          <p class="chamada">
            O que muda na sua conta de luz em Goiás, explicado por quem atende esses casos todo dia — sem promessa que
            a fatura não confirma.
          </p>
        )
      }
      <ul class="blog-lista lista-limpa" role="list">
        {
          posts.map((post) => (
            <li>
              <a class="blog-item" href={`/blog/${post.id}`}>
                <span class="olho">{porSlug(post.data.vertical).nome}</span>
                <h2>{post.data.titulo}</h2>
                <p>{post.data.descricao}</p>
                {/* Mesma razão da data no post: regra que muda em janeiro
                    precisa dizer de quando é antes do clique, não depois. */}
                <time datetime={(post.data.atualizado ?? post.data.publicado).toISOString()}>
                  {dataCurta(post.data.atualizado ?? post.data.publicado)}
                </time>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* 72ch é medida de leitura — aplicada a uma lista de cards, deixava ~40% do
     container vazio a partir de 900px. Mesma correção que o Faq.astro já faz. */
  .blog-lista { margin-top: var(--e-8); gap: var(--e-6); }
  @media (min-width: 900px) {
    .blog-lista { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  }
  .blog-item {
    display: block;
    padding: var(--e-6);
    border: 1px solid var(--borda);
    border-radius: var(--r-3);
    background: var(--superficie-alta);
    text-decoration: none;
    color: inherit;
  }
  .blog-item:hover { background: var(--superficie); }
  .blog-item h2 { margin: var(--e-2) 0 var(--e-2); font-size: var(--t-lg); color: var(--marca-forte); }
  .blog-item p { margin: 0; color: var(--texto-suave); }
  .blog-item time { display: block; margin-top: var(--e-4); font-size: var(--t-sm); color: var(--texto-suave); }
</style>
