---
import Base from "../../layouts/Base.astro";
import LeadForm from "../../components/LeadForm.astro";
import Faq from "../../components/Faq.astro";
import BarraAcao from "../../components/BarraAcao.astro";
import { PARCEIRO_COOPLUZ, CIDADES_COOPLUZ, AREA_SERVIDA } from "../../data/solucoes";
import { ATENDIMENTO, EMPRESA } from "../../consts";

// A última opção do <select> é o coringa "Outra cidade de Goiás" — na lista de
// praças da página ela viraria uma cidade que não existe.
const cidades = CIDADES_COOPLUZ.slice(0, -1);

const perguntas = [
  {
    p: "Preciso investir alguma coisa para começar?",
    r: "Não. Não há taxa de credenciamento, compra de material, estoque nem obrigação de montar equipe. O treinamento é gratuito e o que você precisa ter é rede de contatos na sua cidade.",
  },
  {
    p: "Como funciona a comissão de ativação?",
    r: "Você recebe 50% da primeira receita da conta ativada e paga. Ou seja: entra quando o cliente que você trouxe é efetivamente ativado pela cooperativa e a primeira fatura com desconto é quitada — não na assinatura. O valor por conta varia com o consumo da unidade e consta do termo de credenciamento, apresentado antes da adesão.",
  },
  {
    p: "E os 2% de renda recorrente?",
    r: "Ao atingir 100 contas ativas na sua carteira, você passa a receber 2% sobre toda a receita gerada por ela, todos os meses, enquanto as contas continuarem ativas. É o que transforma indicação avulsa em renda mensal: a carteira segue pagando depois que você parou de ativar.",
  },
  {
    p: "Quanto tempo leva para a primeira conta ativar?",
    r: "O primeiro crédito costuma aparecer na fatura do cliente em até 90 dias, porque depende do ciclo de leitura da Equatorial Goiás e da vinculação da unidade consumidora à cooperativa. A comissão de ativação segue esse prazo — vale contar com ele ao planejar os primeiros meses.",
  },
  {
    p: "Preciso entender de energia solar?",
    r: "Não. O treinamento é gratuito e cobre o suficiente para você explicar o benefício e reconhecer quem se encaixa. Cadastro, contrato e pós-venda ficam com a Autogestor e a Coopluz — você não instala nada e não assume atendimento técnico.",
  },
  {
    p: "Que tipo de cliente eu consigo ativar?",
    r: "Residências, comércios, condomínios e pequenas indústrias atendidos pela Equatorial Goiás com conta média acima de R$ 250 por mês. Abaixo disso o desconto não compensa a operação e a associação não é aceita — a gente diz isso antes, para você não gastar seu relacionamento com uma indicação que vai voltar.",
  },
  {
    p: "Posso atuar em mais de uma cidade?",
    r: "Pode. A área de atuação é todo o estado de Goiás, dentro da concessão da Equatorial. A cidade que você escolhe no cadastro serve para direcionar seu atendimento e o apoio de campanha, não para prender sua carteira a um município.",
  },
  {
    p: "Isso é emprego?",
    r: "Não. É credenciamento de parceiro, sem vínculo empregatício, sem meta imposta e sem exclusividade. A remuneração é por resultado — ativação e carteira —, nos termos do contrato de credenciamento apresentado antes de qualquer adesão.",
  },
];

const site = Astro.site ?? new URL("https://autogestor.roilabs.com.br");
const url = new URL("/coopluz/parceiro", site).href;
const abs = (p: string) => new URL(p, site).href;

const schema = [
  {
    "@type": "Service",
    "@id": `${url}#servico`,
    name: PARCEIRO_COOPLUZ.nome,
    description: PARCEIRO_COOPLUZ.descricao,
    url,
    provider: { "@id": abs("/#organizacao") },
    areaServed: AREA_SERVIDA[PARCEIRO_COOPLUZ.abrangencia],
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: perguntas.map((q) => ({
      "@type": "Question",
      name: q.p,
      acceptedAnswer: { "@type": "Answer", text: q.r },
    })),
  },
];
---

<Base
  titulo={PARCEIRO_COOPLUZ.titulo}
  descricao={PARCEIRO_COOPLUZ.descricao}
  schema={schema}
  trilha={[
    { nome: "Início", href: "/" },
    { nome: "Energia Coopluz", href: "/coopluz" },
    { nome: "Seja parceiro", href: "/coopluz/parceiro" },
  ]}
>
  <section class="topo">
    <div class="container topo__grade">
      <div class="topo__texto">
        <span class="olho">Parceiro autorizado · Energia Coopluz</span>
        <h1>Seja parceiro da Autogestor Energia e construa sua renda recorrente</h1>
        <p class="chamada">
          Uma oportunidade para quem tem relacionamento em Goiás e quer transformar isso em renda todos os meses.
          Você apresenta a economia de 20% na conta de luz, a Autogestor cuida do cadastro e do pós-venda, e você
          recebe na ativação de cada conta — e todo mês sobre a carteira que construir.
        </p>
        <ul class="lista-check destaques" role="list">
          <li>Sem investimento e com treinamento gratuito</li>
          <li>Comissão na ativação mais renda recorrente sobre a carteira</li>
          <li>Área de atuação em todo o estado de Goiás</li>
        </ul>
      </div>
      <div class="topo__form">
        <LeadForm solucao={PARCEIRO_COOPLUZ} titulo="Escolha sua cidade de atuação" instancia="topo" />
      </div>
    </div>
  </section>

  <section class="secao secao--marca">
    <div class="container">
      <span class="olho">Como você é remunerado</span>
      <h2>Duas fontes de receita — e uma delas não para de pagar</h2>
      <ul class="ganhos grade grade--2 lista-limpa" role="list">
        <li>
          <h3>Comissão de ativação</h3>
          <p class="ganhos__numero">50%</p>
          <p>Da primeira receita da conta ativada e paga. Toda conta nova que você trouxer gera esse pagamento.</p>
        </li>
        <li>
          <h3>Renda recorrente</h3>
          <p class="ganhos__numero">2%</p>
          <p>
            Ao atingir 100 contas ativas, sobre toda a receita gerada pela sua carteira, todos os meses, enquanto as
            contas seguirem ativas.
          </p>
        </li>
        <li>
          <h3>Cresça sua carteira</h3>
          <p class="ganhos__numero">+</p>
          <p>Quanto mais clientes ativos, maior a base que paga o recorrente. A renda acumula, não reinicia.</p>
        </li>
        <li>
          <h3>Painel de gestão</h3>
          <p class="ganhos__numero">↗</p>
          <p>Acompanhe cadastros, ativações, comissões e a evolução da sua carteira sem depender de planilha.</p>
        </li>
      </ul>
      <p class="aviso">
        Percentuais e prazos de pagamento constam do termo de credenciamento, apresentado antes de qualquer adesão.
        Programa de parceria, sem vínculo empregatício. Não cobramos nada para você se credenciar.
      </p>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <span class="olho">Área de atuação</span>
      <h2>Todo o estado de Goiás, na área da Equatorial</h2>
      <p class="chamada">
        A energia por compensação da Coopluz vale para qualquer imóvel atendido pela Equatorial Goiás. Estas são as
        praças com maior procura hoje — se a sua cidade não está aqui, ela continua valendo: basta marcar
        "outra cidade de Goiás" no formulário.
      </p>
      <ul class="cidades lista-limpa" role="list">
        {cidades.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="secao secao--suave">
    <div class="container">
      <span class="olho">Por que fecha rápido</span>
      <h2>O produto derruba quatro objeções antes de você falar</h2>
      <div class="grade grade--2">
        <div class="cartao">
          <h3>O que o cliente não precisa fazer</h3>
          <ul class="lista-check" role="list">
            <li><strong>Sem instalação</strong> — nada é montado no telhado nem no imóvel</li>
            <li><strong>Sem consulta ao SPC e Serasa</strong> — não há análise de crédito para associar</li>
            <li><strong>Sem taxa de adesão</strong> — e sem multa para cancelar depois</li>
            <li><strong>Sem transferência da conta</strong> — a titularidade e a distribuidora continuam as mesmas</li>
          </ul>
        </div>
        <div class="cartao">
          <h3>O que a Autogestor põe do lado de cá</h3>
          <ul class="lista-check" role="list">
            <li><strong>Cadastro simples e rápido</strong> — basta uma fatura recente da Equatorial</li>
            <li><strong>Treinamento gratuito</strong> — não precisa entender de energia para começar</li>
            <li><strong>Materiais e campanhas</strong> — arte e argumento prontos para a sua praça</li>
            <li><strong>Suporte especializado</strong> — consultor da casa acompanhando cada cadastro</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <span class="olho">Para quem é</span>
      <h2>Quem já tem relacionamento sai na frente</h2>
      <div class="grade grade--2 perfis">
        <div>
          <h3>Empreendedores e comerciantes</h3>
          <p>Quem atende gente o dia inteiro no balcão e já tem a confiança da vizinhança.</p>
        </div>
        <div>
          <h3>Corretores e consultores</h3>
          <p>Carteira montada e hábito de apresentar proposta. Energia entra como oferta adicional, não como troca.</p>
        </div>
        <div>
          <h3>Correspondentes e representantes</h3>
          <p>Quem já roda campo em Goiás e visita cliente. A ativação encaixa na rota que você faz de qualquer jeito.</p>
        </div>
        <div>
          <h3>Associações, sindicatos e entidades</h3>
          <p>Base associada grande é o caminho mais curto para as 100 contas que destravam o recorrente.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="secao secao--suave">
    <div class="container">
      <Faq perguntas={perguntas} />
    </div>
  </section>

  <section class="secao" id="pedir" tabindex="-1">
    <div class="container fechamento">
      <div>
        <span class="olho">Próximo passo</span>
        <h2>{PARCEIRO_COOPLUZ.fechamento}</h2>
        <p class="chamada">
          Deixe seu WhatsApp e a cidade onde quer atuar. Um consultor da Autogestor responde {ATENDIMENTO.prazo}
          explicando remuneração, treinamento e como é o dia a dia — sem compromisso e sem custo. Autogestor,
          parceira credenciada da Coopluz, em {EMPRESA.endereco.cidade} desde {EMPRESA.fundacao}.
        </p>
        <p class="nota">
          Ainda não conhece o produto que vai apresentar?
          <a href="/coopluz">Veja como funciona a economia de 20% na conta da Equatorial</a>.
        </p>
      </div>
      <LeadForm solucao={PARCEIRO_COOPLUZ} titulo="Escolha sua cidade de atuação" destaque instancia="fim" />
    </div>
  </section>

  <BarraAcao
    solucao={PARCEIRO_COOPLUZ}
    rotulo="Quero ser parceiro"
    mensagem="Olá! Quero ser parceiro da Autogestor na energia Coopluz."
  />
</Base>

<style>
  .destaques { margin-top: var(--e-6); font-weight: 600; }

  .ganhos { margin-top: var(--e-8); }
  /* O auto-fit da .grade--2 deixava 3 + 1 órfão em 1440px. São quatro blocos de
     texto curto: ou os quatro lado a lado (como no impresso), ou dois a dois —
     nunca um sozinho na última linha. */
  @media (min-width: 560px) { .ganhos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 980px) { .ganhos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ganhos li { border-top: 3px solid var(--laranja-500); padding-top: var(--e-4); }
  .ganhos h3 { font-size: var(--t-sm); text-transform: uppercase; letter-spacing: 0.06em; }
  /* O número é o argumento: no impresso é o que a pessoa lê primeiro, e a
     página só cumpre o mesmo papel se sustentar a leitura de relance. */
  .ganhos__numero {
    font-size: var(--t-3xl);
    font-weight: 800;
    line-height: 1;
    color: var(--laranja-400);
    margin: var(--e-2) 0 var(--e-3);
  }
  .ganhos li p:last-child { color: var(--texto-sobre-marca); font-size: var(--t-sm); margin: 0; }
  .aviso { margin-top: var(--e-12); font-size: var(--t-sm); color: var(--texto-sobre-marca-suave); max-width: 78ch; }

  /* Lista, não mapa: o mapa do impresso é decorativo e um SVG de Goiás com 10
     alfinetes é ilegível em 390px de largura.
     ponytail: se um dia a cidade precisar de página própria, cada item vira
     <a> e este CSS continua valendo. */
  .cidades {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-8);
  }
  .cidades li {
    padding: var(--e-2) var(--e-4);
    border: 1px solid var(--borda);
    border-radius: 999px;
    background: var(--superficie-alta);
    font-weight: 600;
    font-size: var(--t-sm);
  }

  /* Mesmo motivo da .ganhos: com quatro perfis, auto-fit sobrava um sozinho. */
  .perfis { margin-top: var(--e-8); gap: var(--e-8); }
  @media (min-width: 700px) { .perfis { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .perfis p { color: var(--texto-suave); font-size: var(--t-sm); }
  .nota { margin-top: var(--e-4); font-size: var(--t-sm); color: var(--texto-suave); }
</style>
