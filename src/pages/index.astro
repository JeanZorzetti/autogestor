---
import Base from "../layouts/Base.astro";
import SolucaoCard from "../components/SolucaoCard.astro";
import LeadForm from "../components/LeadForm.astro";
import Faq from "../components/Faq.astro";
import BarraAcao from "../components/BarraAcao.astro";
import { SOLUCOES, GERAL } from "../data/solucoes";
import { ATENDIMENTO, EMPRESA, whatsapp } from "../consts";

const perguntas = [
  {
    p: "A Autogestor é corretora ou revenda?",
    r: "Corretora registrada na SUSEP sob o nº 202070004, atuando desde 2004. Em seguros representamos você diante da seguradora — não o contrário. Nas outras frentes (energia, viagens, crédito, consórcio e repasse) intermediamos a contratação junto a parceiros credenciados.",
  },
  {
    p: "Cobram alguma coisa para cotar?",
    r: "Não. Cotação, simulação e análise de ficha são gratuitas. Quando existe custo — taxa de administração de consórcio, taxa de operação no repasse — ele é informado antes de qualquer assinatura.",
  },
  {
    p: "Atendem fora de Goiânia?",
    r: "Sim, em todo o Brasil. O escritório fica em Goiânia e o atendimento é por WhatsApp, então a distância não muda nada em seguro, viagens, financiamento, consórcio ou repasse. A única exceção é a energia da Coopluz, que só funciona para imóveis atendidos pela Equatorial Goiás. No repasse, a retirada acontece nos pátios de Goiânia (GO), Contagem (MG) ou Brasília (DF).",
  },
  {
    p: "Como funciona o atendimento?",
    r: `Você escolhe a solução, deixa nome e WhatsApp, e um consultor responde por lá ${ATENDIMENTO.prazo}. O atendimento funciona ${ATENDIMENTO.horario}; fora desse horário, a resposta vem no próximo dia útil. Sem call center, sem ligação automática e sem repassar seus dados para terceiros.`,
  },
  {
    p: "Dá para contratar mais de uma solução?",
    r: "Sim, e é o caso mais comum. Quem faz o seguro do carro costuma aproveitar para reduzir a conta de luz ou financiar o próximo veículo — com o mesmo consultor, sem recomeçar o cadastro.",
  },
];

const site = Astro.site ?? new URL("https://autogestor.roilabs.com.br");
const abs = (p: string) => new URL(p, site).href;

const schema = [
  {
    "@type": "ItemList",
    "@id": abs("/#solucoes"),
    name: "Soluções Autogestor",
    itemListElement: SOLUCOES.map((s, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: s.nome,
      url: abs(`/${s.slug}`),
    })),
  },
  {
    "@type": "FAQPage",
    "@id": abs("/#faq"),
    mainEntity: perguntas.map((q) => ({
      "@type": "Question",
      name: q.p,
      acceptedAnswer: { "@type": "Answer", text: q.r },
    })),
  },
];
---

<Base
  titulo="Autogestor — seguro, energia, viagens, crédito e veículos"
  descricao="Seguro de carro, moto e caminhão, passagens aéreas, financiamento, consórcio e repasse de veículos — em todo o Brasil, desde 2004. Energia com 20% de desconto em Goiás."
  schema={schema}
>
  <section class="capa secao--marca">
    {/* O gesto: a própria marca ampliada até virar textura de fundo. Puramente
         decorativa e entra depois do texto pintar (`animation-delay`), então
         nunca é o elemento de LCP. Sem `view-transition-name`: ela sangra para
         fora da capa e elemento cortado por `overflow: clip` é fotografado sem
         o corte na troca de rota. Quem costura é o carimbo do card, que está
         inteiro dentro dele. */}
    <div class="selo selo--entra selo--migra capa__selo" aria-hidden="true"></div>
    <div class="container topo__grade capa__grade">
      <div class="capa__texto">
        <span class="olho">Hub de soluções em todo o Brasil desde {EMPRESA.fundacao}</span>
        <h1>Seis frentes que pesam no seu mês. <em>Um consultor só</em> para resolver.</h1>
        <p class="chamada capa__chamada">
          Seguro de veículo, desconto na conta de luz, passagem aérea, financiamento, consórcio e compra de seminovo
          direto de locadora. A Autogestor cota, compara e acompanha o contrato — você fala com uma pessoa, não com
          seis empresas.
        </p>
        <div class="capa__acoes">
          <a class="btn btn--primario" href="#solucoes">Ver as seis soluções</a>
          <a
            class="btn btn--contorno externo"
            href={whatsapp("Olá! Não sei qual solução preciso, pode me orientar?")}
            target="_blank"
            rel="noopener"
          >
            Não sei por onde começar
            <span class="visualmente-oculto">— abre em nova aba</span>
          </a>
        </div>
        {/* Dentro da coluna de texto, não abaixo da grade inteira: a coluna do
             formulário é mais alta, e provas soltas depois da grade deixavam
             ~225px de vão vazio sob os CTAs em telas ≥900px. */}
        <ul class="provas" role="list">
          <li><strong>2004</strong><span>atendendo em todo o Brasil</span></li>
          <li><strong>R$ 0</strong><span>para cotar e simular</span></li>
        </ul>
      </div>
      <div>
        <LeadForm solucao={GERAL} titulo="Fale com um consultor" instancia="capa" />
      </div>
    </div>
  </section>

  <section class="secao" id="solucoes" tabindex="-1">
    <div class="container">
      <span class="olho">Escolha por onde começar</span>
      <h2>O que a Autogestor resolve</h2>
      <p class="chamada">Cada frente tem consultor próprio. Clique na sua e peça a cotação em três campos.</p>
      <ul class="grade grade--3 lista-limpa solucoes" role="list">
        {SOLUCOES.map((s) => <SolucaoCard solucao={s} />)}
      </ul>
    </div>
  </section>

  <section class="secao secao--marca">
    <div class="container">
      <span class="olho">Por que reunir tudo aqui</span>
      <h2>Um hub existe para você não repetir seu cadastro seis vezes</h2>
      <div class="grade grade--3 razoes">
        <div>
          <h3>Um consultor, várias frentes</h3>
          <p>
            Quem cuidou do seu seguro é quem simula seu financiamento. Seu histórico já está com a gente — não há
            fila nova nem formulário do zero a cada produto.
          </p>
        </div>
        <div>
          <h3>Comparação, não empurra-empurra</h3>
          <p>
            Em seguro e crédito trabalhamos com várias companhias. Mostramos as opções lado a lado, com o que muda
            em cobertura e em parcela — inclusive quando a resposta é "não vale a pena agora".
          </p>
        </div>
        <div>
          <h3>Gente de Goiânia, no seu WhatsApp</h3>
          <p>
            Escritório no Jardim Europa e o mesmo número desde sempre — atendendo o Brasil inteiro por WhatsApp.
            Sinistro, dúvida de fatura ou remarcação de voo têm para quem ligar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <span class="olho">Como funciona</span>
      <h2>Três passos, sem visita e sem papelada antecipada</h2>
      <ol class="passos" role="list">
        <li>
          <h3>Você escolhe a frente</h3>
          <p>Abre a página da solução e deixa nome, WhatsApp e um dado de contexto. Leva menos de um minuto.</p>
        </li>
        <li>
          <h3>A gente cota e compara</h3>
          <p>
            O consultor busca as opções nas empresas parceiras e volta com os números — valor, cobertura, prazo e o
            que está fora.
          </p>
        </li>
        <li>
          <h3>Você decide com tudo na mão</h3>
          <p>
            Contrato assinado digitalmente e acompanhamento depois da venda. Se decidir não seguir, não há custo
            nem cobrança de nada.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="secao secao--suave">
    <div class="container">
      <Faq perguntas={perguntas} />
    </div>
  </section>

  <BarraAcao alvo="solucoes" rotulo="Ver as soluções" mensagem="Olá! Não sei qual solução preciso, pode me orientar?" />
</Base>

<style>
  .capa {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--e-16) 8rem;
  }
  .capa__grade { position: relative; z-index: 2; }

  /* Matéria do bloco de marca: dois grãos em escalas diferentes leem como
     fibra; um só lê como ruído digital. `soft-light` porque a banda é escura —
     em banda clara seria `overlay`. Acima do selo, abaixo do conteúdo. */
  .capa::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: var(--grao), var(--grao);
    background-size: 240px 240px, 91px 91px;
    mix-blend-mode: soft-light;
    opacity: 0.5;
  }

  /* Salto de escala: 16px de corpo para 80px de título — o eixo `wdth` do
     Archivo é o que torna isso viável numa coluna de 640px. A 76 de largura a
     mesma frase cabe em quatro linhas onde a largura normal pediria seis. A
     fonte variável já estava carregada e o eixo que a diferencia nunca havia
     sido usado num título. */
  .capa h1 {
    font-family: "Archivo", "Archivo capa", var(--fonte);
    font-size: clamp(2.25rem, 1rem + 5.4vw, 5rem);
    font-variation-settings: "wdth" 76, "wght" 830;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  /* A marca (5 arcos em vórtice) ampliada até virar textura, sangrando pelo
     canto inferior ESQUERDO — do lado do texto, não do formulário. Antes ela
     nascia atrás do cartão branco: de 1080px de vórtice viam-se dois arcos
     borrados espremidos na borda, e o gesto da página inteira não era visto.
     Menor e do outro lado, a espiral volta a ler como espiral.

     `mask` com o SVG mono em vez de <img>: o gradiente da página é que pinta a
     marca, então ela lê --lamina/--brasa e acompanha o tema — um <img> traria
     as cores congeladas dentro do arquivo.

     Opacidade e giro moram em .selo (global.css), junto das duas camadas de
     movimento: entra girando, encolhe e migra com o scroll até o formato do
     carimbo do card. */
  .capa__selo {
    --giro: -10deg;
    inline-size: min(108vw, 820px);
    inset-block-end: -34%;
    inset-inline-start: -14%;
  }
  /* Sob 900px a capa fica ~3x mais alta (o formulário passa para baixo do
     texto), e ancorar o selo no rodapé dela o jogava ~1.400px abaixo da
     primeira dobra: o gesto da direção não existia para a maioria do tráfego,
     que é celular. Aqui ele é ancorado pelo TOPO, sangrando pela direita na
     altura das ações — a faixa da primeira tela que fica vazia. */
  @media (max-width: 899px) {
    .capa__selo {
      inline-size: min(155vw, 640px);
      inset-block-start: 190px;
      inset-inline-end: -52%;
      inset-inline-start: auto;
      inset-block-end: auto;
      --selo-op: 0.17;
    }
    .capa { padding-block: var(--e-12) 12rem; }
  }

  /* Camada de entrada. O H1 e a chamada NÃO entram: são os dois candidatos a
     LCP desta página (medido: `p.chamada`), e elemento de LCP que anima
     opacidade é LCP adiado. O que chega em volta deles é a mobília — olho,
     ações e provas — atrás do selo, que é quem abre a cena. */
  @media (prefers-reduced-motion: no-preference) {
    .capa__texto .olho,
    .capa__acoes,
    .provas {
      animation: capa-chega var(--dur-cena) var(--ease-cena) both;
    }
    .capa__texto .olho { animation-delay: 60ms; }
    .capa__acoes { animation-delay: 220ms; }
    .provas { animation-delay: 300ms; }
  }
  @keyframes capa-chega {
    from { opacity: 0; translate: 0 14px; }
  }

  h1 em { font-style: normal; color: var(--brasa); }
  .capa__chamada { font-size: var(--t-lg); }
  .capa__acoes { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-8); }
  .provas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-8);
    list-style: none;
    margin: var(--e-12) 0 0;
    padding: var(--e-6) 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.18);
  }
  .capa__texto { min-width: 0; }
  /* No celular o H1 já corta na 4ª linha na primeira dobra — o olho repete
     "todo o Brasil desde 2004" que o H1 e a chamada já dizem logo abaixo. */
  .capa__texto .olho { display: none; }
  @media (min-width: 600px) {
    .capa__texto .olho { display: block; }
  }
  .provas li { display: grid; }
  .provas strong {
    font-family: var(--display);
    font-variation-settings: "wdth" 68, "wght" 900;
    font-size: 2.75rem;
    line-height: 1;
    color: var(--texto-invertido);
  }
  .provas span { font-size: var(--t-sm); color: var(--texto-sobre-marca); }

  /* Seis cards iguais em 3x2 é a mesma laje que o resto da página já era, e
     ainda por cima na seção que carrega o produto. A grade quebra em 2 + 4:
     as duas frentes de maior volume ganham o dobro de largura e a linha de
     baixo lê como quarteto, não como sobra da linha de cima. Abaixo de 900px
     volta ao auto-fit de uma coluna só — assimetria em 390px é só quebra. */
  .solucoes { margin-top: var(--e-8); }
  @media (min-width: 900px) {
    .solucoes {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--e-6);
    }
    .solucoes :global(.scard) { grid-column: span 3; }
    .solucoes :global(.scard:nth-child(-n + 2)) { grid-column: span 6; }
  }
  .razoes { margin-top: var(--e-8); gap: var(--e-8); }
  .razoes p { color: var(--texto-sobre-marca); }

  .passos {
    display: grid;
    gap: var(--e-8);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin: var(--e-8) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: passo;
  }
  .passos li { counter-increment: passo; }
  .passos li::before {
    content: counter(passo);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--r-full);
    background: var(--acento);
    color: var(--acento-texto);
    font-weight: 700;
    margin-bottom: var(--e-4);
  }
  .passos p { color: var(--texto-suave); }
</style>
