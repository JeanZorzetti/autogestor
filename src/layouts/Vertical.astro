---
import Base from "./Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Faq from "../components/Faq.astro";
import type { Pergunta } from "../components/Faq.astro";
import SolucaoCard from "../components/SolucaoCard.astro";
import BarraAcao from "../components/BarraAcao.astro";
import { SOLUCOES, AREA_SERVIDA, type Solucao } from "../data/solucoes";
import { ATENDIMENTO, EMPRESA } from "../consts";

interface Props {
  solucao: Solucao;
  h1: string;
  chamada: string;
  perguntas: readonly Pergunta[];
  /** Tipo de nó schema.org que melhor descreve a vertical. */
  tipoServico?: string;
  /** H2 do formulário do topo e rótulo da barra fixa mobile. Default serve bem
   *  quando a solução é comparada entre provedores (seguro, viagem); vertical
   *  com preço fixo (ex.: desconto de %) tem motivo para trocar "cotação". */
  tituloForm?: string;
  rotuloBarra?: string;
}
const {
  solucao,
  h1,
  chamada,
  perguntas,
  tipoServico = "Service",
  tituloForm = "Peça sua cotação",
  rotuloBarra = "Pedir cotação",
} = Astro.props;
const site = Astro.site ?? new URL("https://autogestor.roilabs.com.br");
const url = new URL(`/${solucao.slug}`, site).href;
const outras = SOLUCOES.filter((s) => s.slug !== solucao.slug);

const schema = [
  {
    "@type": tipoServico,
    "@id": `${url}#servico`,
    name: solucao.nome,
    description: solucao.descricao,
    url,
    // Coopluz é quem presta o serviço; a Autogestor é representante credenciada
    // (broker), não a prestadora. Marcar as duas como `provider` contradiz a
    // copy da página, e dado estruturado que contradiz o texto visível é o
    // tipo de coisa que motor de resposta para de citar.
    provider: solucao.provedor ? { name: solucao.provedor } : { "@id": new URL("/#organizacao", site).href },
    ...(solucao.provedor && { broker: { "@id": new URL("/#organizacao", site).href } }),
    areaServed: AREA_SERVIDA[solucao.abrangencia],
  },
  {
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: perguntas.map((q) => ({
      "@type": "Question",
      name: q.p,
      acceptedAnswer: { "@type": "Answer", text: q.r.replace(/<[^>]+>/g, "") },
    })),
  },
];
---

<Base
  titulo={solucao.titulo}
  descricao={solucao.descricao}
  schema={schema}
  trilha={[
    { nome: "Início", href: "/" },
    { nome: solucao.nome, href: `/${solucao.slug}` },
  ]}
>
  <section class="topo">
    <div class="container topo__grade">
      <div class="topo__texto">
        {/* A outra ponta da costura. Mesmo `view-transition-name` do carimbo
             que esta solução tem no card da home: o selo de 96px que a pessoa
             clicou sobe e vira a marca desta página, sem fade e sem router —
             o navegador interpola posição, tamanho e forma sozinho.

             Em fluxo (position: relative), com espaço próprio: elemento
             absoluto por baixo do texto seria fotografado fora do lugar, e o
             gate de contraste não quer gradiente por trás de h1 em superfície
             clara. */}
        <span
          class="selo selo--claro selo--entra capa-vertical__selo"
          aria-hidden="true"
          style={`view-transition-name: costura-${solucao.slug}`}
        ></span>
        <span class="olho">{solucao.nome}</span>
        <h1>{h1}</h1>
        <p class="chamada">{chamada}</p>
        <slot name="hero" />
      </div>
      {/* Todas as verticais que sobraram aqui captam lead. O slot "form", que
           deixava a vertical self-service trocar o formulário pela própria
           busca, saiu junto com `/viagens` em agosto/2026 — era um slot sem
           nenhum preenchedor. Se uma nova vertical self-service aparecer, o
           padrão a copiar é o site em C:/dev/viagens, não este layout. */}
      <div class="topo__form">
        <LeadForm solucao={solucao} titulo={tituloForm} instancia="topo" />
      </div>
    </div>
  </section>

  <slot />

  <section class="secao secao--suave">
    <div class="container">
      <Faq perguntas={perguntas} />
    </div>
  </section>

  <section class="secao" id="pedir" tabindex="-1">
    <div class="container fechamento">
      {
        Astro.slots.has("fechamento") ? (
          <slot name="fechamento" />
        ) : (
          <Fragment>
            <div>
              <span class="olho">Próximo passo</span>
              <h2>{solucao.fechamento}</h2>
              <p class="chamada">
                Um consultor da Autogestor responde no seu WhatsApp {ATENDIMENTO.prazo}. Corretora desde {EMPRESA.fundacao},
                registro SUSEP {EMPRESA.susep}, com sede em {EMPRESA.endereco.cidade} e atendimento em todo o Brasil.
              </p>
            </div>
            <LeadForm solucao={solucao} titulo={tituloForm} destaque instancia="fim" />
          </Fragment>
        )
      }
    </div>
  </section>

  <section class="secao secao--suave">
    <div class="container">
      <span class="olho">Também resolvemos</span>
      <h2>Outras soluções do hub</h2>
      <ul class="grade grade--3 lista-limpa" role="list">
        {outras.map((s) => <SolucaoCard solucao={s} />)}
      </ul>
    </div>
  </section>

  <BarraAcao solucao={solucao} rotulo={rotuloBarra} />
</Base>

<style>
  .capa-vertical__selo {
    /* `display: block` não é adorno: .selo é `position: absolute`, que
       blocifica o <span> sozinho. Ao trazê-lo de volta para o fluxo com
       `relative` ele volta a ser inline — e em elemento inline não-substituído
       `inline-size` e `aspect-ratio` não se aplicam. O selo existia no DOM com
       0x0 e a capa saiu sem marca nenhuma. */
    display: block;
    position: relative;
    /* Cheio, não fantasma: aqui o selo não está por trás de texto nenhum, e é
       o destino da transição — chegar em 0.14 faria a costura terminar num
       borrão. É o único ponto do site onde a marca aparece opaca em tamanho
       grande. */
    --selo-op: 0.9;
    --giro: -8deg;
    /* Aqui, sim, o par completo da marca: o selo tem espaço próprio, não há
       texto por cima e é o destino da costura — chegar num azul chapado seria
       chegar em menos do que se clicou. */
    --selo-a: var(--marca);
    --selo-b: var(--acento-hover);
    inline-size: clamp(88px, 17vw, 168px);
    margin-bottom: var(--e-4);
  }
</style>
