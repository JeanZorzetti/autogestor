---
import { SOLUCOES, ICONES } from "../data/solucoes";
import { EMPRESA, whatsapp } from "../consts";
import Logo from "./Logo.astro";

const { pathname } = Astro.url;
const atual = (href: string) => pathname === href || pathname === `${href}/`;
---

<header class="cabecalho">
  <div class="container cabecalho__linha">
    <a href="/" class="marca" aria-label={`${EMPRESA.nome} — página inicial`}>
      <Logo size={40} />
      <span class="marca__nome">Autogestor</span>
    </a>
    {/* WhatsApp antes do nav no DOM porque é essa a ordem do CELULAR, onde os
         dois ficam em linhas diferentes: logo e WhatsApp em cima, as 6
         verticais embaixo. Com o nav antes, o Tab pulava a barra inteira antes
         de chegar num botão que se vê ali no topo — 6 links de distância entre
         o que se lê e o que recebe foco. No desktop o `order` recoloca o nav no
         meio e a inversão que sobra é de dois itens vizinhos, na mesma linha. */}
    <a class="cabecalho__zap externo" href={whatsapp("Olá! Vim pelo site da Autogestor.")} target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONES.zap} />
      WhatsApp
      <span class="visualmente-oculto">— abre em nova aba</span>
    </a>
    {/* Sem hambúrguer: 6 verticais cabem numa barra que quebra no celular.
         Menu fechado esconde exatamente o que a pessoa veio procurar.
         "Sobre" não é uma solução (já vive no rodapé) — incluí-lo aqui abria
         uma linha extra só para ele. */}
    <nav class="nav" aria-label="Soluções">
      <ul class="nav__lista" role="list">
        {
          SOLUCOES.map((s) => (
            <li>
              <a href={`/${s.slug}`} aria-current={atual(`/${s.slug}`) ? "page" : undefined}>
                {s.curto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecalho {
    background: var(--superficie-alta);
    border-bottom: 1px solid var(--borda);
    z-index: 20;
  }
  /* Sticky só a partir do desktop. No celular a barra tem 209px (o nav de 6
     verticais quebra em 3 linhas) — grudar isso no topo custaria um quarto da
     tela em toda rolagem, e a barra inteira já aparece na primeira dobra. */
  @media (min-width: 900px) {
    .cabecalho { position: sticky; top: 0; }
  }
  .cabecalho__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding-block: var(--e-3);
  }
  .marca {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: var(--e-2);
    text-decoration: none;
    color: var(--marca-forte);
  }
  .marca__nome {
    font-weight: 700;
    font-size: var(--t-lg);
    letter-spacing: -0.02em;
  }
  .cabecalho__zap {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding-inline: var(--e-4);
    border-radius: var(--r-full);
    background: var(--azul-100);
    color: var(--marca-forte);
    font-weight: 700;
    font-size: var(--t-sm);
    text-decoration: none;
  }
  .cabecalho__zap:hover { background: var(--cinza-100); }

  /* Abaixo de 900px o nav não cabe ao lado da logo e do WhatsApp: vira sua
     própria linha cheia (flex-basis:100% força a quebra), com a aparência de
     barra secundária (fundo e borda) que já existia. Nenhum `order` aqui — a
     ordem visual do celular é a ordem do DOM, e é o que o Tab percorre. A
     partir de 900px o nav sobe para o meio da linha única. */
  .nav {
    flex-basis: 100%;
    border-top: 1px solid var(--borda);
    background: var(--superficie);
    margin-inline: calc(-1 * var(--e-4));
    width: calc(100% + var(--e-8));
  }
  @media (min-width: 900px) {
    .nav {
      order: 2;
      flex-basis: auto;
      width: auto;
      margin-inline: 0;
      border-top: none;
      background: none;
    }
    /* Nav sobe para o meio aqui (a logo fica no order 0 implícito) — o zap
       precisa ir para depois dele. */
    .cabecalho__zap { order: 3; }
  }
  .nav__lista {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-1) var(--e-2);
    list-style: none;
    margin-block: 0;
    padding-inline: var(--e-4);
    padding-block: var(--e-2);
  }
  /* Abaixo de 600px, 6 itens em `wrap` custavam 3 linhas (~150px só de nav).
     Rolagem horizontal com snap mantém as 6 visíveis (afordável pela borda de
     saída) sem empurrar o H1 quase uma tela inteira para baixo. */
  @media (max-width: 599px) {
    .nav__lista {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }
    .nav__lista li { flex: none; scroll-snap-align: start; }
  }
  @media (min-width: 900px) {
    .nav__lista { padding: 0; }
  }
  .nav__lista a {
    /* flex + min-height para o alvo de toque bater 44px: com padding sozinho o
       link ficava em 38px, e o nav é o elemento mais tocado do site no celular. */
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--e-2) var(--e-3);
    border-radius: var(--r-2);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--texto-suave);
    text-decoration: none;
  }
  .nav__lista a:hover { background: var(--cinza-100); color: var(--texto); }
  /* Página atual marcada por peso + barra, não só por cor. */
  .nav__lista a[aria-current="page"] {
    color: var(--marca-forte);
    background: var(--fundo);
    box-shadow: inset 0 -3px 0 var(--acento);
  }
</style>
