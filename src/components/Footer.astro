---
import { SOLUCOES } from "../data/solucoes";
import { ATENDIMENTO, EMPRESA, enderecoLinha, whatsapp } from "../consts";
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container rodape__grade">
    <div>
      <p class="rodape__marca">Autogestor</p>
      <p class="rodape__texto">
        Hub de soluções em energia, seguros, viagens, crédito e veículos. Atendimento em todo o Brasil, de
        Goiânia, desde {EMPRESA.fundacao}.
      </p>
      <p class="rodape__texto">
        Corretora registrada na SUSEP sob o nº {EMPRESA.susep}.
      </p>
    </div>

    <nav aria-label="Soluções (rodapé)">
      <h2 class="rodape__titulo">Soluções</h2>
      <ul class="rodape__links" role="list">
        {SOLUCOES.map((s) => <li><a href={`/${s.slug}`}>{s.nome}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Institucional">
      <h2 class="rodape__titulo">Institucional</h2>
      <ul class="rodape__links" role="list">
        <li><a href="/sobre">Sobre a Autogestor</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/seja-parceiro">Seja um parceiro</a></li>
        <li><a href="/privacidade">Privacidade</a></li>
        <li><a href="/termos">Termos de uso</a></li>
        <li>
          <a class="externo" href={whatsapp("Olá! Vim pelo site da Autogestor.")} target="_blank" rel="noopener">
            Falar no WhatsApp<span class="visualmente-oculto"> — abre em nova aba</span>
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="rodape__titulo">Atendimento</h2>
      <address class="rodape__texto">
        {enderecoLinha}<br />
        Atendimento {ATENDIMENTO.horarioCurto}<br />
        <a href={`tel:${EMPRESA.telefone}`}>{EMPRESA.telefoneExibicao}</a><br />
        <a href={`mailto:${EMPRESA.email}`}>{EMPRESA.email}</a>
      </address>
      <ul class="rodape__redes" role="list">
        <li><a href={EMPRESA.redes[0]} rel="me noopener">Instagram</a></li>
        <li><a href={EMPRESA.redes[1]} rel="me noopener">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="container rodape__base">
    <div class="rodape__linha">
      <p>© {ano} {EMPRESA.nomeLegal}. CNPJ e condições contratuais disponíveis sob solicitação.</p>

      {/* No rodapé, não no cabeçalho: a primeira linha do cabeçalho já leva
           logo e WhatsApp, e um quarto item quebrava para outra linha — 194px
           viravam 254px de cabeçalho fixo em toda rolagem, no celular, para um
           controle usado uma vez por visita.
           Nasce `hidden`: sem JavaScript não faria nada, e botão morto é pior
           que botão ausente. O script revela — e só se light-dark() existir.
           Rótulo visível em vez de aria-label: o texto na tela É o nome
           acessível, e diz a ação ("Ativar…"), não o estado. */}
      <button class="tema" type="button" hidden>
        <svg class="tema__lua" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1z" />
        </svg>
        <svg class="tema__sol" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
        </svg>
        <span class="tema__rotulo">Ativar tema escuro</span>
      </button>
    </div>
    <p class="rodape__aviso">
      Seguro, consórcio e financiamento estão sujeitos a análise e à aceitação da seguradora, administradora ou
      instituição financeira. As condições apresentadas aqui não substituem a proposta formal.
    </p>
  </div>
</footer>

<style>
  .rodape {
    background: var(--superficie-marca);
    color: var(--texto-sobre-marca);
    padding-block: var(--e-16) var(--e-8);
  }
  .rodape__grade {
    display: grid;
    gap: var(--e-8);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .rodape__marca { color: var(--texto-invertido); font-size: var(--t-lg); font-weight: 700; margin-bottom: var(--e-2); }
  .rodape__titulo { color: var(--texto-invertido); font-size: var(--t-sm); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--e-4); }
  .rodape__texto { font-size: var(--t-sm); font-style: normal; line-height: 1.7; }
  .rodape__links, .rodape__redes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e-2); font-size: var(--t-sm); }
  .rodape__redes { margin-top: var(--e-4); grid-auto-flow: column; justify-content: start; gap: var(--e-4); }
  .rodape a { color: var(--link-sobre-marca); }
  .rodape a:hover { color: var(--texto-invertido); }
  .rodape__base {
    margin-top: var(--e-12);
    padding-top: var(--e-6);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    font-size: var(--t-sm);
  }
  .rodape__aviso { color: var(--texto-sobre-marca-suave); max-width: 78ch; }

  .rodape__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
  }
  /* Sobre --superficie-marca em qualquer tema: as cores do corpo (--texto-suave)
     não têm contraste sobre o azul. Mesmo par que .secao--marca .btn--contorno
     já usa. O anel de foco branco vem da regra `.rodape :focus-visible`. */
  .tema {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    min-height: 44px;
    padding-inline: var(--e-3);
    /* 0.40 e não 0.25: o contorno é o ÚNICO limite visual do botão (fundo
       transparente), então WCAG 1.4.11 pede 3:1 contra o rodapé. 0.25 dava
       2.09:1; 0.40 dá 3.28:1 no claro e 3.32:1 no escuro. */
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--r-full);
    background: transparent;
    color: var(--texto-sobre-marca);
    font: inherit;
    font-size: var(--t-sm);
    cursor: pointer;
    flex: none;
  }
  .tema:hover { background: rgba(255, 255, 255, 0.12); color: var(--texto-invertido); }
  .tema[hidden] { display: none; }
  /* Um ícone por vez, escolhido pelo atributo que o script escreve. Ler o tema
     direto no CSS exigiria repetir a regra para media query e para data-tema. */
  .tema__sol { display: none; }
  .tema[data-escuro] .tema__lua { display: none; }
  .tema[data-escuro] .tema__sol { display: block; }
</style>

<script>
  // Só aparece se a troca realmente funcionar: sem light-dark() o tema escuro
  // nem é aplicado (está atrás de @supports), então o botão seria um controle
  // que promete e não entrega.
  const botao = document.querySelector<HTMLButtonElement>(".tema");

  if (botao && CSS.supports("color", "light-dark(#fff, #000)")) {
    const raiz = document.documentElement;
    const rotulo = botao.querySelector<HTMLElement>(".tema__rotulo")!;
    // Sem escolha salva, quem manda é o sistema operacional.
    const escuroDoSistema = matchMedia("(prefers-color-scheme: dark)");
    const estaEscuro = () => (raiz.dataset.tema ? raiz.dataset.tema === "escuro" : escuroDoSistema.matches);

    const sincronizar = () => {
      const escuro = estaEscuro();
      botao.toggleAttribute("data-escuro", escuro);
      rotulo.textContent = escuro ? "Ativar tema claro" : "Ativar tema escuro";
      // As duas <meta> são escopadas por media e seguiriam o sistema, não a
      // escolha: numa troca manual a barra de endereço ficaria do tema oposto
      // ao da página. Escrever a mesma cor nas duas resolve sem remover nada.
      const cor = escuro ? "#060d19" : "#002b74";
      document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.setAttribute("content", cor));
    };

    botao.hidden = false;
    sincronizar();

    botao.addEventListener("click", () => {
      raiz.dataset.tema = estaEscuro() ? "claro" : "escuro";
      try {
        localStorage.setItem("tema", raiz.dataset.tema);
      } catch {}
      sincronizar();
    });

    // Enquanto não houver escolha salva, acompanhar o sistema em tempo real —
    // senão o rótulo continuaria anunciando o tema anterior.
    escuroDoSistema.addEventListener("change", () => {
      if (!raiz.dataset.tema) sincronizar();
    });
  }

  // Delegado no documento porque o link "Chamar no WhatsApp" existe em vários
  // componentes (cabeçalho, rodapé, formulário, capa) — um listener por lugar
  // duplicaria a mesma linha cinco vezes.
  document.addEventListener("click", (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="https://wa.me/"]');
    if (a) (window as any).gtag?.("event", "clique_whatsapp", { pagina: location.pathname });
  });
</script>
