---
import type { Solucao } from "../data/solucoes";
interface Props { solucao: Solucao }
const { solucao } = Astro.props;
---

<li class="scard">
  <span class="scard__icone" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={solucao.icone} />
  </span>
  <h3 class="scard__titulo">
    {/* O card inteiro é clicável pelo ::after, mas o link real é o título:
         leitor de tela anuncia "Energia Coopluz", não "leia mais". */}
    <a href={`/${solucao.slug}`}>{solucao.nome}</a>
  </h3>
  <p class="scard__resumo">{solucao.resumo}</p>
  <span class="scard__seta" aria-hidden="true">Ver solução →</span>
</li>

<style>
  .scard {
    position: relative;
    overflow: clip;
    background: var(--superficie-alta);
    border: 1px solid var(--borda);
    border-radius: var(--r-3);
    padding: var(--e-6);
    transition: border-color 120ms ease, transform 120ms ease, box-shadow 120ms ease;
  }
  .scard:hover { border-color: var(--marca); transform: translateY(-2px); box-shadow: var(--sombra-sm); }
  /* Eco do gesto do herói: uma lâmina só por card, saindo do mesmo canto em
     seis ângulos — a mesma convergência do vórtice, em miniatura. Decorativa,
     atrás do conteúdo; pivô no canto para o leque abrir de card para card. */
  .scard::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset-block-start: 0;
    inset-inline-end: 0;
    inline-size: 68%;
    block-size: 3px;
    background: linear-gradient(90deg, transparent, var(--marca) 55%, var(--marca) 80%, var(--marca));
    transform-origin: 100% 0%;
    /* Negativo = sentido anti-horário: o braço, que parte apontando para a
       esquerda a partir do canto, desce para dentro do card em vez de subir
       para fora dele. */
    transform: rotate(calc(-34deg - var(--giro, 0deg)));
    opacity: 0.35;
    transition: opacity 200ms var(--curva);
  }
  .scard:hover::before { opacity: 0.75; }
  .scard:nth-child(1) { --giro: 0deg; }
  .scard:nth-child(2) { --giro: 7deg; }
  .scard:nth-child(3) { --giro: 14deg; }
  .scard:nth-child(4) { --giro: 21deg; }
  .scard:nth-child(5) { --giro: 28deg; }
  .scard:nth-child(6) { --giro: 35deg; }
  .scard:has(a:focus-visible) { outline: 3px solid var(--foco); outline-offset: 2px; }
  .scard__icone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-2);
    background: var(--azul-100);
    color: var(--marca-forte);
    margin-bottom: var(--e-4);
  }
  .scard__titulo { font-size: var(--t-md); margin-bottom: var(--e-2); }
  .scard__titulo a { color: var(--marca-forte); text-decoration: none; }
  .scard__titulo a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  /* Sem :has(), o anel some do link e não reaparece em lugar nenhum — quem tem
     :focus-visible mas não :has() (Firefox <121) navega os cards sem foco
     visível. O anel só some quando o navegador sabe redesenhá-lo no card. */
  @supports selector(:has(*)) {
    .scard__titulo a:focus-visible { outline: none; }
  }
  .scard__resumo { color: var(--texto-suave); font-size: var(--t-sm); margin: 0; }
  /* Afordância persistente: cor + sublinhado no título somem no toque (sem
     hover), e o cursor:pointer também. Isto é o único sinal que sobrevive. */
  .scard__seta {
    display: block;
    margin-top: var(--e-3);
    font-size: var(--t-sm);
    font-weight: 600;
    color: var(--marca);
  }
</style>
