<style>
  /* Valores claros crus: é o que sobra se light-dark() não existir — o bloco
     inteiro do @supports cai fora e a marca fica na versão clara. */
  .logo {
    --lg-b0: #0a6fbd;
    --lg-b1: #005ca6;
    --lg-b2: #002b74;
    --lg-o0: #eb8f68;
    --lg-o1: #e47a45;
    --lg-o2: #d26831;

    display: block;
  }

  @supports (color: light-dark(#fff, #000)) {
    .logo {
      --lg-b0: light-dark(#0a6fbd, #9cc4ff);
      --lg-b1: light-dark(#005ca6, #6fa6f2);
      --lg-b2: light-dark(#002b74, #4a86d8);
      --lg-o0: light-dark(#eb8f68, #f5a074);
      --lg-o1: light-dark(#e47a45, #eb8f68);
      --lg-o2: light-dark(#d26831, #dd7648);
    }
  }
</style>
